{
  "name": "tessar-workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.5.3",
  "engines": {
    "node": ">=24.14.0"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "tsc --noEmit -p tsconfig.tests.json",
    "test": "vitest run --configLoader native --pool threads --exclude tests/integration/**",
    "test:integration": "vitest run --configLoader native --pool threads tests/integration",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "test:storage": "node --env-file-if-exists=.env.storage node_modules/vitest/vitest.mjs run packages/postgresql/test packages/mongodb/test --configLoader native --pool threads"
  },
  "devDependencies": {
    "@tessar/core": "workspace:*",
    "@tessar/plugins": "workspace:*",
    "@tessar/sqlite": "workspace:*",
    "@types/node": "^24.0.0",
    "typescript": "7.0.2",
    "vitest": "5.0.4",
    "zod": "^4.6.7",
    "@tessar/postgresql": "workspace:*",
    "@tessar/mongodb": "workspace:*"
  }
}
