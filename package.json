{
  "name": "tesseract-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.5.3",
  "engines": {
    "node": ">=24.14.0"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "tsc --noEmit -p tsconfig.tests.json",
    "test": "vitest run --configLoader native --pool threads --exclude tests/integration/**",
    "test:integration": "vitest run --configLoader native --pool threads tests/integration",
    "check:boundaries": "node scripts/check-boundaries.mjs"
  },
  "devDependencies": {
    "@tesseract/core": "workspace:*",
    "@tesseract/storage-sqlite": "workspace:*",
    "@types/node": "^24.0.0",
    "typescript": "7.0.2",
    "vitest": "5.0.4"
  }
}

