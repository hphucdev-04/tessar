{
  "name": "@tessar/core",
  "version": "0.1.0-alpha.0",
  "description": "Minimal agent execution, sessions, hooks, state and checkpoints.",
  "type": "module",
  "engines": { "node": ">=24.14.0" },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hphucdev-04/tesseract.git",
    "directory": "packages/core"
  },
  "publishConfig": { "access": "public", "tag": "next", "registry": "https://registry.npmjs.org/" },
  "exports": {
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "import": "./dist/testing/index.js"
    },
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./tool": {
      "types": "./dist/tools/tool.d.ts",
      "import": "./dist/tools/tool.js"
    },
    "./testing/storage-conformance": {
      "types": "./dist/testing/storage-conformance.d.ts",
      "import": "./dist/testing/storage-conformance.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "files": [
    "dist",
    "src/models/catalog.LICENSE"
  ]
}
