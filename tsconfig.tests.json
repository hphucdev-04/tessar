{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "types": [
      "node"
    ],
    "paths": {
      "@tesseract/plugins/logger": ["./packages/plugins/src/logger.ts"],
      "@tesseract/plugins": ["./packages/plugins/src/index.ts"],
      "@tesseract/core": [
        "./packages/core/src/index.ts"
      ],
      "@tesseract/core/tool": [
        "./packages/core/src/tools/tool.ts"
      ],
      "@tesseract/core/testing": [
        "./packages/core/src/testing/index.ts"
      ],
      "@tesseract/sqlite": [
        "./packages/sqlite/src/index.ts"
      ],
      "@tesseract/openai": [
        "./packages/openai/src/index.ts"
      ],
      "@tesseract/core/testing/storage-conformance": [
        "./packages/core/src/testing/storage-conformance.ts"
      ]
    }
  },
  "include": [
    "packages/*/src/**/*.ts",
    "packages/*/test/**/*.ts",
    "tests/**/*.ts",
    "examples/**/*.ts",
    "vitest.config.ts"
  ]
}
