{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "types": [
      "node"
    ],
    "paths": {
      "@tesseract/core": [
        "./packages/core/src/index.ts"
      ],
      "@tesseract/core/testing": [
        "./packages/core/src/testing/index.ts"
      ],
      "@tesseract/storage-sqlite": [
        "./packages/storage-sqlite/src/index.ts"
      ],
      "@tesseract/openai": [
        "./packages/openai/src/index.ts"
      ],
      "@tesseract/core/testing/storage-conformance": [
        "./packages/core/src/testing/storage-conformance.ts"
      ]
    }
  },
  "include": [
    "packages/**/*.ts",
    "tests/**/*.ts",
    "examples/**/*.ts",
    "vitest.config.ts"
  ]
}
